# Rasa devcontainer environment template.
#
# IMPORTANT: goes in .devcontainer/, not the repo root -- docker-compose's
# `env_file: - .env` resolves relative to the compose file's own location.
# Copy to .devcontainer/.env (never commit the real one). Rasa has no
# Python-level dotenv loading, so this is the only way these vars load.

# --- Tracker store / thread-index Redis ---------------------------------
# Provisioned by the devcontainer's own "redis" service -- these defaults
# already point at it. Also the shared token vault Webapp/CVaLab use
# (exposed to the host on 6379 for that reason).

TRACKER_STORE_URL=redis
TRACKER_STORE_PORT=6379
TRACKER_STORE_DB=0
RASA_TRACKER_STORE_BACKEND=redis

# --- Auth ------------------------------------------------------------------

# Same value Action/CVaLab use when calling Rasa's custom routes.
RASA_AUTH_TOKEN=
RASA_REQUIRE_AUTH_TOKEN=true

# --- Misc --------------------------------------------------------------

# Bare http(s)://host[:port] only -- only needed for direct browser calls.
# RASA_CORS=

# Override the RASA_TRACKER_STORE_BACKEND-based endpoints.yml lookup.
# RASA_ENDPOINTS_FILE=

# Version/build metadata for GET /version -- cosmetic, safe to leave unset.
# RASA_VERSION=
# RASA_COMMIT_SHA=
# RASA_IMAGE_TAG=
# RASA_BUILD_DATE=
# RASA_SSOT_VERSION=
